"""Where the project finds its schema, its datamodel, its exposure file and its data.

The values come from the answers the linkmo copier template recorded in
``{{ _copier_conf.answers_file }}`` at the host root, and ``copier update`` rewrites this
file when an answer changes. Each value can be replaced for one run by the environment
variable named beside it, which is how a test points the project at a fixture.

A path is read from the host root unless it is absolute. A schema or a data directory
that is inside an installed package is written ``pkg:<package>/<path>``.
"""

from __future__ import annotations

import importlib.util
import os
import sys
from pathlib import Path

PACKAGE_DIR = Path(__file__).resolve().parent
PROJECT_DIR = PACKAGE_DIR.parents[1]
HOST_ROOT = PROJECT_DIR.parent

ENV_PREFIX = "{{ env_prefix }}"
COMMAND_NAME = "{{ command_name }}"
DISTRIBUTION = "{{ linkmo_dir }}"


def _setting(name: str, default: str) -> str:
    return os.environ.get(f"{ENV_PREFIX}_{name}", default)


# {{ env_prefix }}_SCHEMA: the LinkML schema.
SCHEMA = _setting("SCHEMA", "{{ schema_path }}")
# {{ env_prefix }}_DATAMODEL: the module gen-pydantic wrote from the schema.
DATAMODEL_MODULE = _setting("DATAMODEL", "{{ datamodel_module }}")
# {{ env_prefix }}_ROOT_CLASS: the class a data file holds; empty means the tree_root class.
ROOT_CLASS = _setting("ROOT_CLASS", "{{ root_class }}")
# {{ env_prefix }}_EXPOSURE: the exposure file, read from the project folder unless absolute.
EXPOSURE = _setting("EXPOSURE", "{{ exposure_file }}")
# {{ env_prefix }}_DATA_SOURCE: "yaml" for a directory of instance files, "python" for an object.
DATA_SOURCE = _setting("DATA_SOURCE", "{{ data_source }}")
# {{ env_prefix }}_DATA: the directory of instance files, or the object as module:attribute.
DATA = _setting("DATA", "{{ data_path if data_source == 'yaml' else data_object }}")
# {{ env_prefix }}_OPENAPI: where `just gen-openapi` publishes the API's contract.
OPENAPI = _setting("OPENAPI", "{{ openapi_file }}")
# {{ env_prefix }}_ENTITIES: where `just gen-ui-config` writes a web UI's entity list.
ENTITIES = _setting("ENTITIES", "{{ entities_file }}")

# Folders put first on sys.path, when they exist, before the datamodel, a Python data
# source or hand.py is imported. The sidecar's src/ is one, because gen-pydantic writes
# the datamodel there.
MODULE_PATHS = [HOST_ROOT / "{{ sidecar_dir or '.' }}" / "src"]
# Folders put last on sys.path, so that a Python data source or hand.py can import the
# host's own modules while every installed package keeps its place.
HOST_PATHS = [HOST_ROOT]


def add_module_paths() -> None:
    """Put MODULE_PATHS first on sys.path and HOST_PATHS last, once each."""
    for path in MODULE_PATHS:
        if path.is_dir() and str(path) not in sys.path:
            sys.path.insert(0, str(path))
    for path in HOST_PATHS:
        if path.is_dir() and str(path) not in sys.path:
            sys.path.append(str(path))


def host_path(value: str, base: Path = HOST_ROOT) -> Path:
    """Resolve a path setting: ``pkg:`` inside an installed package, else from ``base``.

    The package is found without being imported, so a heavy package costs nothing here.
    """
    if value.startswith("pkg:"):
        package, _, inner = value[len("pkg:") :].partition("/")
        spec = importlib.util.find_spec(package)
        if spec is None or not spec.submodule_search_locations:
            raise FileNotFoundError(
                f"{value}: no installed package named {package}. Add its distribution to the "
                "requirements answer, or set LINKMO_PYTHON to a Python that has it."
            )
        return Path(list(spec.submodule_search_locations)[0]) / inner
    path = Path(value).expanduser()
    return path if path.is_absolute() else base / path


def schema_path() -> Path:
    return host_path(SCHEMA)


def exposure_path() -> Path:
    return host_path(EXPOSURE, PROJECT_DIR)


def data_path() -> Path:
    return host_path(DATA)


def openapi_path() -> Path:
    return host_path(OPENAPI)


def entities_path() -> Path:
    return host_path(ENTITIES)
